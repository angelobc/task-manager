# Database
POSTGRES_DB=taskmanager
DB_USERNAME=taskmanager
DB_PASSWORD=taskmanager_password

# JWT — secret must be at least 32 characters for HS256
JWT_SECRET=change-me-to-a-secure-random-string-minimum-32-chars!!
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# CORS — comma-separated list of allowed frontend origins.
# Defaults to "*" for local development. In production, set this to
# the actual frontend URL(s), e.g. https://task-manager-frontend-4hrn.onrender.com
CORS_ALLOWED_ORIGINS=*
